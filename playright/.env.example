# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Clerk and Supabase are optional for local practice. You can import a file
# and practice in-session without signing in. Saving to the score library
# requires both services configured.

# Clerk — https://dashboard.clerk.com/~/api-keys
# Or run: clerk env pull (after clerk auth login && clerk init)
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase — optional; required for the score library
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Playwright sets these when you run `npm run test:e2e`. Leave unset for
# normal local development. Set VITE_E2E=1 to attach the browser harness;
# set VITE_E2E_AUDIO=1 as well if that run should load piano samples.
# VITE_E2E=
# VITE_E2E_AUDIO=
CLERK_SECRET_KEY=
